#!/usr/bin/env bash
# Set up (or repair) this machine for ivan-the-terminal. Idempotent; safe to re-run.
set -euo pipefail
ITT_HOME="${ITT_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
PRIVATE_DIR="${ITT_PRIVATE_DIR:-$(dirname "$ITT_HOME")/ivan-the-terrible}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
say() { printf '==> %s\n' "$*"; }

link() {  # link TARGET PATH: refresh symlinks, back up a real file/dir once
  local target=$1 path=$2
  if [ -L "$path" ]; then ln -sfn "$target" "$path"
  elif [ -e "$path" ]; then mv "$path" "$path.pre-itt.$(date +%Y%m%d%H%M%S)"; ln -s "$target" "$path"; say "backed up existing $path"
  else mkdir -p "$(dirname "$path")"; ln -s "$target" "$path"; fi
}

say "toolchain"
command -v brew >/dev/null || { echo "Homebrew is required: https://brew.sh (preinstalled on Bazzite)" >&2; exit 1; }
missing=()
while read -r cmd formula _; do
  case "$cmd" in ''|'#'*) continue ;; esac
  command -v "$cmd" >/dev/null || missing+=("$formula")
done < "$ITT_HOME/toolchain.txt"
if [ ${#missing[@]} -gt 0 ]; then brew install "${missing[@]}"; fi

say "git hooks"
git -C "$ITT_HOME" config core.hooksPath .githooks

say "itt on PATH (~/.local/bin)"
link "$ITT_HOME/bin/itt" "$HOME/.local/bin/itt"

say "shell: interactive claude starts in ivan-the-terminal (~/.bashrc.d)"
link "$ITT_HOME/shell/claude-home.bash" "$HOME/.bashrc.d/claude-home.sh"
grep -qs 'bashrc.d' "$HOME/.bashrc" || say "WARNING: ~/.bashrc doesn't source ~/.bashrc.d; add: for rc in ~/.bashrc.d/*; do . \"\$rc\"; done"

say "skills -> ~/.claude/skills"
for s in "$ITT_HOME"/plugins/*/skills/*/; do
  [ -f "$s/SKILL.md" ] && link "${s%/}" "$HOME/.claude/skills/$(basename "$s")"
done

say "plugin timers and services (systemd --user)"
for unit in "$ITT_HOME"/plugins/*/systemd/*.service "$ITT_HOME"/plugins/*/systemd/*.timer; do
  [ -e "$unit" ] || continue
  [ "$(readlink -f "$CFG/systemd/user/$(basename "$unit")")" = "$unit" ] || systemctl --user link "$unit" >/dev/null
done
systemctl --user daemon-reload
# Timers, and long-running services that declare [Install]; oneshot services are started by their timers.
for unit in "$ITT_HOME"/plugins/*/systemd/*.timer "$ITT_HOME"/plugins/*/systemd/*.service; do
  [ -e "$unit" ] || continue
  case "$unit" in *.service) grep -q '^\[Install\]' "$unit" || continue ;; esac
  systemctl --user enable --now "$(basename "$unit")" >/dev/null 2>&1
done

say "private overlay"
if [ ! -d "$PRIVATE_DIR/.git" ]; then
  repo="${ITT_PRIVATE_REPO:-$(gh api user -q .login 2>/dev/null || echo unknown)/ivan-the-terrible}"
  gh repo clone "$repo" "$PRIVATE_DIR" 2>/dev/null || say "no private overlay ($repo not reachable): generic mode"
fi
if [ -x "$PRIVATE_DIR/bin/bootstrap" ]; then "$PRIVATE_DIR/bin/bootstrap"; fi
if [ -s "$CFG/ivan-the-terminal/leakguard.denylist" ]; then
  git -C "$ITT_HOME" config leakguard.requireDenylist true
fi

say "done. Next: itt doctor"
