#!/usr/bin/env python3
"""Every gate a branch must pass before it is pushed to the public remote. Stdlib only; Linux and Windows."""
import os
import subprocess
import sys
from pathlib import Path

ITT_HOME = Path(os.environ.get("ITT_HOME") or Path(__file__).resolve().parents[1])


def git(*args):
    return subprocess.run(["git", *args], cwd=ITT_HOME, capture_output=True, text=True)


def gate(*cmd):
    if subprocess.run([str(c) for c in cmd], cwd=ITT_HOME).returncode:
        sys.exit(1)  # the failing step already explained itself


def main():
    if git("status", "--porcelain").stdout.strip():
        sys.exit("ship-check: uncommitted changes; commit or stash first")
    git("fetch", "-q", "origin")
    mb = git("merge-base", "HEAD", "origin/main")
    base = mb.stdout.strip() if mb.returncode == 0 else "--root"

    lg = [sys.executable, "-I", "tools/leakguard/leakguard.py"]
    if git("config", "--bool", "leakguard.requireDenylist").stdout.strip() == "true":
        lg.append("--require-denylist")
    gate(*lg, "tree")
    gate(*lg, "range", base, "HEAD")
    gate("gitleaks", "git", "--redact", "--no-banner", "--log-level", "warn", ".")
    gate(sys.executable, "-I", "tools/run_tests.py", "--shellcheck")
    gate(sys.executable, "-I", "tools/lint_skills.py")
    n = git("rev-list", "--count", "HEAD" if base == "--root" else f"{base}..HEAD").stdout.strip()
    print(f"ship-check: clean ({n} commit(s) checked)")


if __name__ == "__main__":
    main()
