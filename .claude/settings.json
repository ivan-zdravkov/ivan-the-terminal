{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "LEAKGUARD_ROOT=\"$CLAUDE_PROJECT_DIR\" python3 -I \"$CLAUDE_PROJECT_DIR/tools/leakguard/leakguard.py\" claude-hook"
          }
        ]
      }
    ]
  }
}
