#!/usr/bin/env bash
# job-digest: run the weekday job digest headless (claude -p) with a fixed tool allowlist and a guard.
#   run            real run (what the timer does): searches, triages Gmail, drafts replies, stores one digest, pushes
#   run --dry-run  assemble prompt + command and print a summary; runs nothing
#   run --serve    run the Jobs app server (what job-digest-server.service does)
# Private config: ~/.config/ivan-the-terminal/job-digest/{config.env,profile.md} (see ../config.example)
set -uo pipefail
SKILL="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ivan-the-terminal/job-digest"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ivan-the-terminal/job-digest"
mode="${1:-}"

if [ ! -f "$CONF/config.env" ] || [ ! -f "$CONF/profile.md" ]; then
  echo "job-digest: not configured: create $CONF/config.env and profile.md (templates in $SKILL/config.example)"
  exit 0
fi
MODEL="claude-sonnet-5-5"
# shellcheck source=/dev/null
. "$CONF/config.env"

TOOLS="$SKILL/scripts"
[ "$mode" = --serve ] && exec "$TOOLS/jobs" serve

mkdir -p "$STATE/work" "$STATE/logs"
WORK=$(readlink -f "$STATE/work") LOGS="$STATE/logs"  # resolved: permission rules see real paths (/home may be a symlink)
find "$WORK" -mindepth 1 -delete

prompt=$(python3 -I - "$SKILL/references/prompt.md" "$CONF/profile.md" "$WORK" "$TOOLS" <<'PY'
import sys
template, profile, work, tools = sys.argv[1:]
text = open(template, encoding="utf-8").read()
for key, value in (("{{PROFILE}}", open(profile, encoding="utf-8").read().strip()), ("{{WORK}}", work),
                   ("{{TOOLS}}", tools)):
    text = text.replace(key, value)
print(text)
PY
)

settings="$STATE/settings.json"
jq -n --arg guard "$TOOLS/guard.py" --arg tools "$TOOLS" --arg work "$WORK" '{hooks: {PreToolUse: [{
  matcher: "Bash|Write|Edit|mcp__claude_ai_Gmail__.*",
  hooks: [{type: "command", command: ("python3 -I " + ([$guard, $tools, $work] | map(@sh) | join(" ")))}]}]}}' > "$settings"

# Least privilege: no interpreter, no raw curl, Read/Write only inside WORK, no sending mail at all (the digest
# goes to the Jobs app). Untrusted mail and web pages flow through this run, so anything broader turns a prompt
# injection into code execution, file exfiltration or mail sent in the candidate's name.
G=mcp__claude_ai_Gmail
work_rule="/$WORK/**"  # "//abs/path" is the permission-rule syntax for an absolute path
cmd=(claude -p --model "$MODEL" --permission-mode dontAsk --settings "$settings"
  --allowedTools
    "Bash($TOOLS/fetch:*)" "Bash($TOOLS/q:*)" "Bash($TOOLS/html:*)" "Bash($TOOLS/jobs:*)" "Bash(date:*)"
    "Read($work_rule)" "Edit($work_rule)" "WebSearch" "WebFetch"
    "${G}__search_threads" "${G}__get_thread" "${G}__get_message" "${G}__list_labels"
    "${G}__label_thread" "${G}__label_message" "${G}__list_drafts" "${G}__get_draft"
    "${G}__create_draft" "${G}__unlabel_thread"
  --disallowedTools
    "${G}__send_message" "${G}__forward" "${G}__reply" "${G}__trash_message" "${G}__trash_thread"
    "${G}__delete_draft" "${G}__delete_label" "${G}__mark_message_spam" "${G}__mark_thread_spam"
    "${G}__update_draft" "${G}__untrash_message" "${G}__untrash_thread" "${G}__create_label" "${G}__update_label"
    "NotebookEdit")

if [ "$mode" = --dry-run ]; then
  echo "prompt: $(wc -c <<<"$prompt") bytes, $(grep -c '{{' <<<"$prompt") unfilled placeholders"
  echo "model: $MODEL  work: $WORK"
  echo "guard: $(jq -r '.hooks.PreToolUse[0].hooks[0].command' "$settings")"
  echo "allowed: $(printf '%s\n' "${cmd[@]}" | sed -n '/--allowedTools/,/--disallowedTools/p' | sed '1d;$d' | tr '\n' ' ')"
  echo "status:"; "$TOOLS/jobs" status | sed 's/^/  /'
  "$TOOLS/jobs" url || true
  exit 0
fi

LOG="$LOGS/$(date +%F_%H%M).log"
cd "$WORK" || exit 1  # cwd = work dir: nothing else is in default read scope
JOB_DIGEST_WORK="$WORK" "${cmd[@]}" <<<"$prompt" >"$LOG" 2>&1  # prompt on stdin: not visible in /proc/*/cmdline
status=$?
if [ $status -eq 0 ] && ! "$TOOLS/jobs" has-digest; then status=3; fi  # finished without storing a digest
if [ $status -eq 0 ]; then "$TOOLS/jobs" notify >>"$LOG" 2>&1; fi  # best effort: the app shows it either way
if [ $status -ne 0 ] && command -v notify-send >/dev/null; then notify-send "Job digest failed" "See $LOG"; fi
find "$LOGS" -name '*.log' -mtime +30 -delete
exit $status
