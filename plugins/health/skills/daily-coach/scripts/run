#!/usr/bin/env bash
# daily-coach: build today's plan headless (claude -p) from ring data + check-ins, store it for the Daily app, push.
#   run               make today's plan (re-plans if one exists: check-ins on matching item ids are kept)
#   run --if-missing  only if today has no plan yet (what the wake trigger and the fallback timer use)
#   run --dry-run     assemble prompt + command and print a summary; runs nothing
#   run --serve       run the check-in/ingest server (what daily-coach-server.service does)
# Private config: ~/.config/ivan-the-terminal/daily-coach/{config.env,profile.md} (see ../config.example)
set -uo pipefail
SKILL="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ivan-the-terminal/daily-coach"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ivan-the-terminal/daily-coach"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/ivan-the-terminal/daily-coach"
mode="${1:-}"

if [ ! -f "$CONF/config.env" ] || [ ! -f "$CONF/profile.md" ]; then
  echo "daily-coach: not configured: create $CONF/config.env and profile.md (templates in $SKILL/config.example)"
  exit 0
fi
MODEL="claude-sonnet-5-5" WEB_DOMAINS=""
# shellcheck source=/dev/null
. "$CONF/config.env"

TOOLS="$SKILL/scripts"
[ "$mode" = --serve ] && exec "$TOOLS/coach" serve
if [ "$mode" = --if-missing ] && "$TOOLS/coach" has-plan; then exit 0; fi

mkdir -p "$STATE/work" "$STATE/logs" "$DATA"
exec 9>"$STATE/lock"
flock -n 9 || { echo "daily-coach: a run is already in progress"; exit 0; }
WORK=$(readlink -f "$STATE/work") LOGS="$STATE/logs"  # resolved: permission rules see real paths
find "$WORK" -mindepth 1 -delete

prompt=$(python3 -I - "$SKILL/references/prompt.md" "$CONF/profile.md" "$WORK" "$TOOLS" <<'PY'
import sys
template, profile, work, tools = sys.argv[1:]
text = open(template, encoding="utf-8").read()
for key, value in (("{{PROFILE}}", open(profile, encoding="utf-8").read().strip()), ("{{WORK}}", work),
                   ("{{TOOLS}}", tools)):
    text = text.replace(key, value)
print(text)
PY
)

settings="$STATE/settings.json"
# shellcheck disable=SC2086  # WEB_DOMAINS is a space-separated list: one jq arg per domain
jq -n --arg guard "$TOOLS/guard.py" --arg tools "$TOOLS" --arg work "$WORK" \
  --args '{hooks: {PreToolUse: [{
  matcher: "Bash|Write|Edit|WebFetch|mcp__.*",
  hooks: [{type: "command", command: ("python3 -I " + ([$guard, $tools, $work] + $ARGS.positional | map(@sh) | join(" ")))}]}]}}' \
  $WEB_DOMAINS > "$settings"

# Least privilege: no interpreter, Read/Write only inside WORK, no mail or other MCP tools (the plan goes to the
# app). Recipe pages are untrusted, so nothing here may turn an injection into code, mail or a leak.
work_rule="/$WORK/**"  # "//abs/path" = absolute path; Edit(...) rules also cover Write (Write(...) rules are ignored)
cmd=(claude -p --model "$MODEL" --permission-mode dontAsk --settings "$settings"
  --allowedTools
    "Bash($TOOLS/coach:*)" "Bash(date:*)" "Read($work_rule)" "Edit($work_rule)" "WebSearch" "WebFetch"
  --disallowedTools "mcp__claude_ai_Gmail" "NotebookEdit")

if [ "$mode" = --dry-run ]; then
  echo "prompt: $(wc -c <<<"$prompt") bytes, $(grep -c '{{' <<<"$prompt") unfilled placeholders"
  echo "model: $MODEL  work: $WORK"
  echo "guard: $(jq -r '.hooks.PreToolUse[0].hooks[0].command' "$settings")"
  echo "status:"; "$TOOLS/coach" status | sed 's/^/  /'
  "$TOOLS/coach" url
  exit 0
fi

LOG="$LOGS/$(date +%F_%H%M).log"
cd "$WORK" || exit 1
DAILY_COACH_WORK="$WORK" "${cmd[@]}" <<<"$prompt" >"$LOG" 2>&1  # prompt on stdin: not visible in /proc/*/cmdline
status=$?
rm -f "$DATA/last-trigger"  # let the phone trigger again if this run failed
if [ "$status" -eq 0 ] && ! "$TOOLS/coach" has-plan; then status=3; fi  # finished without storing a plan
if [ "$status" -eq 0 ]; then "$TOOLS/coach" notify >>"$LOG" 2>&1; fi  # best effort: the app shows it either way
if [ "$status" -ne 0 ] && command -v notify-send >/dev/null; then notify-send "Daily coach failed" "See $LOG"; fi
find "$LOGS" -name '*.log' -mtime +30 -delete
exit "$status"
