# ~/.config/ivan-the-terminal/daily-coach/config.env
MODEL="claude-sonnet-5-5"
TOKEN=""                             # empty: generated once into the data dir, outside any repo (`coach url` shows the links)
BIND="127.0.0.1"                     # localhost only: `tailscale serve` publishes it on the tailnet with HTTPS
PORT=8765
PUBLIC_URL="https://<machine>.<tailnet>.ts.net"   # the tailscale serve address: links, shortcut URLs, push sender id
DAY_START_HOUR=4                     # before 04:00 still counts as the previous day (night wake-ups)
AUTO_PLAN_HOUR=6                     # a ring sync after this hour, 20+ min after the night ended, starts the plan
WEB_DOMAINS=""                       # recipe sites the run may WebFetch, space-separated (empty = any https site)
LEVEL_NAMES=""                       # optional, comma-separated names for levels 1, 2, 3, ...

# ~/.config/ivan-the-terminal/daily-coach/profile.md   (inserted into the morning prompt as PROFILE)
# ## Me           age, height, work pattern, likely/diagnosed conditions that change the approach (e.g. ADHD)
# ## Household    who lives with you, kids' ages, pets, who does night duty
# ## Goals        what you want in 3 months (weight, shape, sleep, mood), and what "a good day" looks like
# ## History      sports you loved and why, what failed before and why
# ## Equipment    what is at home (kettlebells, bands, bar), stairs, park, dog walks
# ## Food         who cooks, shops nearby, likes/dislikes, allergies, sweet tooth, salt, drinks
# ## Recipes      location for seasonality, language, sites to search (e.g. local recipe sites), family constraints
# ## Constraints  injuries, time windows, things never to suggest
# ## Tone         how you want to be spoken to
