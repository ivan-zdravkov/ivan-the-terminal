[Unit]
Description=Daily coach: the Daily phone app and Health ingest (localhost only; tailscale serve publishes it on the tailnet)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
ExecStart=%h/.local/bin/itt run daily-coach --serve
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
